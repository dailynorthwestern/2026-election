---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ElectionHero from '../components/election/ElectionHero.astro';
import PhotoGallery from '../components/election/PhotoGallery.astro';
import { galleryImages } from '../data/gallery.js';
import ReportedStories from '../components/election/ReportedStories.astro';
import { reportedStories } from '../data/reportedStories.js';
import RaceFeaturesSection from '../components/election/RaceFeaturesSection.astro';
import { federalRaces, stateRaces } from '../data/races.js';
import { election } from '../data/election.js';
import '../styles/election.scss';
---
<Layout title={election.title} description={election.subtitle}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://use.typekit.net/lgx3dbo.css" />
  </Fragment>
  <Header />
  <main id="main-content" tabindex="-1">
  <div class="election-page">
    <ElectionHero {...election} />
  </div>
  <PhotoGallery images={galleryImages} />
  <RaceFeaturesSection id="federal-races" title="Federal Races" races={federalRaces} />
  <RaceFeaturesSection id="state-races" title="State Races" races={stateRaces} />
  <ReportedStories stories={reportedStories} />
  </main>
  <Footer credits={election.credits} />
</Layout>
