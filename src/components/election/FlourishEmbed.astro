---
const { visualizationId, embedUrl, title } = Astro.props;
// Normalize published Flourish URLs to the official iframe embed endpoint.
let id = visualizationId == null ? '' : String(visualizationId);
if (embedUrl) {
  const url = new URL(embedUrl);
  if (!['public.flourish.studio', 'flo.uri.sh', 'app.flourish.studio'].includes(url.hostname) || url.protocol !== 'https:') {
    throw new Error('Use an HTTPS Flourish visualization URL.');
  }
  id = url.pathname.match(/^\/visualisation\/(\d+)(?:\/embed)?\/?$/)?.[1] || '';
  if (!id) throw new Error('Flourish URL must contain /visualisation/ followed by its numeric ID.');
}
if (id && !/^\d+$/.test(id)) throw new Error('Flourish visualization IDs must be numeric.');
const src = id ? `https://flo.uri.sh/visualisation/${id}/embed` : null;
---
<div class="race-visualization">
  {src ? <iframe src={src} title={title} loading="lazy" allowfullscreen></iframe> :
    <div class="race-visualization-placeholder" role="img" aria-label={`${title}: visualization to come`}>Flourish visualization</div>}
</div>
