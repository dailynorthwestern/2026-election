---
import { Image } from 'astro:assets';
import { asset } from '../../lib/content.js';
const { image, imageAlt = '', blurb } = Astro.props;
---
<div class="hero-blurb-layout">
  {image && <div class="hero-blurb-artwork">
    {typeof image === 'object' ?
      <Image class="hero-blurb-image" src={image} alt={imageAlt} widths={[400, 800, 1200]} sizes="(min-width: 1025px) 36vw, (min-width: 768px) 52vw, 80vw" format="webp" /> :
      <img class="hero-blurb-image" src={asset(image)} alt={imageAlt} />}
  </div>}
  <div class="election-blurb"><p>{blurb}</p></div>
</div>
