---
const { id } = Astro.props;
---
<h2 id={id} class="election-section-heading"><slot /></h2>
<style>
.election-section-heading {
  width: 100%;
  margin: 0 auto 28px;
  padding: 14px 24px 18px;
  border: 4px solid var(--election-red);
  border-radius: 999px;
  background: var(--election-light-blue);
  color: var(--election-blue);
  text-align: center;
  font-family: var(--font-election-headline);
  font-weight: 700;
  font-size: clamp(2rem, 4.4vw, 4rem);
  line-height: 1.2;
}
@media (max-width: 767px) {
  .election-section-heading { border-width: 3px; margin-bottom: 20px; }
}
</style>
