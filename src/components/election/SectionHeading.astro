---
const { id } = Astro.props;
---
<h2 id={id} class="election-section-heading"><slot /></h2>
<style>
.election-section-heading {
  width: 100%;
  margin: 0 auto 28px;
  
  color: var(--election-light-blue);
  text-align: center;
  font-family: var(--font-election-headline);
  font-style: normal;
  font-weight: 700;
  font-size: clamp(2rem, 4vw, 4rem);
  line-height: 1.2;
}
.election-section-heading::after {
  content: '';
  display: block;
  width: 100%;
  height: 6px;
  margin-top: 16px;
  border-top: 1px solid var(--election-red);
  border-bottom: 1px solid var(--election-red);
}
@media (max-width: 767px) {
  .election-section-heading { border-width: 3px; margin-bottom: 20px; }
}
</style>
