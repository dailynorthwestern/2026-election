---
import SectionHeading from './SectionHeading.astro';
import StoryCard from './StoryCard.astro';
import '../../styles/reported-stories.scss';
const { stories } = Astro.props;
---
<section class="reported-stories" aria-labelledby="reported-stories-heading">
  <div class="election-content-container">
    <SectionHeading id="reported-stories-heading">Reported Stories</SectionHeading>
  </div>
  <div class="reported-stories-grid">
    {stories.map(story => <StoryCard story={story} />)}
  </div>
</section>
